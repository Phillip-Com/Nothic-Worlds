# Formatting and naming rules for the whole repo (see CLAUDE.md Sections 6 and 9).
# Enforced by `dotnet format` and shown as warnings during builds.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,csproj,props,targets,xml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Godot writes these files itself; don't fight its formatting.
[*.{godot,tscn,tres,import,cfg}]
indent_style = tab

[*.cs]
# Layout
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true

# Prefer clear code
dotnet_style_readonly_field = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion

# --- Naming conventions ---
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate, interface
dotnet_naming_symbols.members.applicable_kinds = method, property, event, field
dotnet_naming_symbols.members.applicable_accessibilities = public, internal, protected, protected_internal
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Order matters: more specific rules first.
dotnet_naming_rule.interfaces_have_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_have_i_prefix.style = i_prefix
dotnet_naming_rule.interfaces_have_i_prefix.severity = warning

dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal_case
dotnet_naming_rule.constants_are_pascal.severity = warning

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_rule.types_are_pascal.symbols = types
dotnet_naming_rule.types_are_pascal.style = pascal_case
dotnet_naming_rule.types_are_pascal.severity = warning

dotnet_naming_rule.members_are_pascal.symbols = members
dotnet_naming_rule.members_are_pascal.style = pascal_case
dotnet_naming_rule.members_are_pascal.severity = warning

dotnet_naming_rule.locals_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_are_camel.style = camel_case
dotnet_naming_rule.locals_are_camel.severity = warning
